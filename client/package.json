{
  "name": "client",
  "version": "1.0.0",
  "private": true,
  "description": "React client for Chatty",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "concurrently --kill-others-on-fail --names server,client --prefix-colors yellow,cyan \"npm --prefix ../server run dev\" \"npm run client\"",
    "dev": "npm start",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run"
  }
}
